{
  "name": "zwift-log-parser",
  "version": "0.0.1",
  "description": "TypeScript console application for parsing Zwift log files",
  "main": "dist/cli/main.js",
  "type": "module",
  "bin": {
    "zwift-log-parser": "./bin/zwift-log-parser.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "preferGlobal": true,
  "scripts": {
    "build": "nx run-many --target=build --projects=core,cli",
    "prepare": "npm run build",
    "start": "node dist/cli/main.js",
    "zwift-log-parser": "tsx --tsconfig cli/tsconfig.app.json cli/src/main.ts",
    "dev": "nx build cli --watch",
    "clean": "rimraf dist",
    "pack": "npm pack --pack-destination dist",
    "lint": "nx run-many --target=lint --projects=core,cli",
    "test": "nx run-many --target=test --projects=core,cli"
  },
  "keywords": [
    "zwift",
    "log",
    "parser"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "asciichart": "^1.5.25",
    "chalk": "^5.3.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nx/esbuild": "22.3.3",
    "@nx/eslint": "^22.3.3",
    "@nx/eslint-plugin": "22.3.3",
    "@nx/js": "^22.3.3",
    "@nx/node": "^22.3.3",
    "@nx/vite": "^22.3.3",
    "@nx/vitest": "22.3.3",
    "@nx/web": "22.3.3",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/asciichart": "^1.5.4",
    "@types/node": "20.19.9",
    "@vitest/coverage-v8": "^4.0.0",
    "@vitest/ui": "^4.0.0",
    "ajv": "^8.0.0",
    "esbuild": "^0.19.2",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jiti": "2.4.2",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "22.3.3",
    "prettier": "~3.6.2",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.0.0",
    "vite-plugin-dts": "~4.5.0",
    "vitest": "^4.0.0"
  },
  "nx": {}
}
