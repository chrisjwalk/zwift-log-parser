{
  "name": "zwift-log-parser",
  "version": "0.0.1",
  "description": "TypeScript console application for parsing Zwift log files",
  "main": "dist/cli/main.js",
  "type": "module",
  "bin": {
    "zwift-log-parser": "bin/zwift-log-parser.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "preferGlobal": true,
  "workspaces": [
    "core",
    "cli"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "start": "node dist/cli/main.js",
    "zwift-log-parser": "bun run cli/src/main.tsx",
    "dev": "bun run cli/src/main.tsx",
    "clean": "rimraf dist",
    "pack": "npm pack --pack-destination dist",
    "lint": "eslint core/src cli/src",
    "test": "vitest run"
  },
  "keywords": [
    "zwift",
    "log",
    "parser",
    "fps",
    "analysis",
    "cycling",
    "performance"
  ],
  "author": "Christopher J. Walker",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chrisjwalk/zwift-log-parser.git"
  },
  "bugs": {
    "url": "https://github.com/chrisjwalk/zwift-log-parser/issues"
  },
  "homepage": "https://github.com/chrisjwalk/zwift-log-parser#readme",
  "dependencies": {
    "@inquirer/prompts": "^8.2.0",
    "asciichart": "^1.5.25",
    "chalk": "^5.3.0",
    "commander": "^14.0.2",
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@types/asciichart": "^1.5.4",
    "@types/node": "20.19.9",
    "@types/react": "^18.3.23",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "~3.6.2",
    "rimraf": "^6.1.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.0.0"
  }
}
