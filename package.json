{
  "name": "zwift-log-parser",
  "version": "0.0.1",
  "description": "TypeScript console application for parsing Zwift log files",
  "main": "dist/cli/main.js",
  "type": "module",
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.3.11",
  "bin": {
    "zwift-log-parser": "bin/zwift-log-parser.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "workspaces": [
    "core",
    "cli"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "start": "node dist/cli/main.js",
    "dev": "bun run cli/src/main.tsx",
    "clean": "rimraf dist",
    "pack": "npm pack --pack-destination dist",
    "lint": "eslint core/src cli/src",
    "test": "bun test"
  },
  "keywords": [
    "zwift",
    "log",
    "parser",
    "fps",
    "analysis",
    "cycling",
    "performance"
  ],
  "author": "Christopher J. Walker",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chrisjwalk/zwift-log-parser.git"
  },
  "bugs": {
    "url": "https://github.com/chrisjwalk/zwift-log-parser/issues"
  },
  "homepage": "https://github.com/chrisjwalk/zwift-log-parser#readme",
  "dependencies": {
    "@inquirer/prompts": "^8.4.1",
    "asciichart": "^1.5.25",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "ink": "^7.0.0",
    "react": "^19.2.5",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/asciichart": "^1.5.8",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "~3.9.4",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "vite": ">=7.3.2",
    "rollup": ">=4.59.0"
  }
}
